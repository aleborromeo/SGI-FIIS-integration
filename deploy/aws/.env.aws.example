# Generate .env.aws with config.py; this file contains no real credentials.
DATA_MODE=restore
DB_NAME=db_fiis_investigacion
DB_USER=sgi
DB_PASSWORD=GENERATE_WITH_CONFIG_PY
JWT_SECRET=GENERATE_WITH_CONFIG_PY
PUBLIC_URL=http://localhost
SITE_ADDRESS=http://localhost
BIND_ADDRESS=127.0.0.1
IMAGE_TAG=local
# Mock mode does not send registration/reset emails; use for initial checks only.
APP_MAIL_MOCK=true
APP_MAIL_FROM=
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
AZURE_CLIENT_ID=dummy-client-id
AZURE_CLIENT_SECRET=dummy-client-secret
AZURE_TENANT_ID=common
